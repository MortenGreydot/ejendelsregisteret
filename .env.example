# ---------------------------------------------------------------------------
# Next.js — hører hjemme i .env.local
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ betyder at værdien inlines i browser-bundlen og er offentligt
# læsbar. Læg ALDRIG en hemmelig nøgle bag det præfiks.

NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...


# ---------------------------------------------------------------------------
# Edge functions — sættes med `supabase secrets set`, IKKE i .env.local
# ---------------------------------------------------------------------------
# Next-appen bruger ingen af dem. De læses kun af koden i
# supabase/functions/, som kører på Supabase. Ligger de i .env.local, bliver
# de hverken brugt eller beskyttet — de bliver bare et sted mere hvor en
# hemmelig nøgle kan lække fra.
#
# Til lokal kørsel med `supabase functions serve` lægges de i stedet i
# supabase/functions/.env, som er gitignoreret.

# Stripe-adgang
STRIPE_SECRET_KEY=sk_test_...              # hemmelig. Aldrig i frontend.
STRIPE_WEBHOOK_SECRET=whsec_...            # verificerer at events kommer fra Stripe

# Priser. Klienten sender kun planId; funktionen slår price-id'et op her,
# så prisen ikke kan ændres i devtools inden checkout oprettes.
STRIPE_PRICE_PRIVAT=price_...              # medlemskab, graduated tiered
STRIPE_PRICE_ERHVERV=price_...             # medlemskab, graduated tiered
STRIPE_PRICE_SETUP=price_...               # oprettelsesgebyr, privat, one-time
STRIPE_PRICE_SETUP_ERHVERV=price_...       # oprettelsesgebyr, erhverv, one-time

# Hvor Stripe sender brugeren hen efter betaling. Uden skråstreg til sidst.
SITE_URL=http://localhost:3000

# Token som pg_cron sender i X-Cron-Secret til report-usage. Ligger også i
# Vault under navnet `cron_secret`, hvorfra cron-jobbet læser den.
CRON_SECRET=<tilfældig streng>
